        "python3 {SCRIPTS}/figure1_assemble.py"


rule rarefaction_curves:
    # QC plot — rarefaction curves for all 66 bariatric samples (PRE/POST).
    # Informs choice of rarefaction depth for alpha diversity analyses.
    input:
        ps = "data/processed/ps_filt_5vs6.rds"
    output:
        "results/figures/qc/rarefaction_curves.png"
    shell:
        "Rscript {SCRIPTS}/rarefaction_curves.R"


rule figure_lfc_clinical:
    # Ridge plot of log2(POST/PRE) for continuous clinical variables (mirrors Olsson Fig. 1a).
    input:
        data   = "data/processed/bariatric_clinical_66.csv",
        config = "config/config.yaml"
    output:
        "results/figures/figure_lfc_clinical.png"
    shell:
        "python3 {SCRIPTS}/figure_lfc_clinical.py"


rule descriptive_clinical:
    # PRE-baseline descriptive table (n=33). Variable selection in config.yaml.
    input:
        data   = "data/processed/bariatric_clinical_66.csv",
        config = "config/config.yaml"
    output:
        csv  = "results/tables/descriptive_baseline.csv",
        html = "results/tables/descriptive_baseline.html"
    shell:
        "python3 {SCRIPTS}/descriptive_clinical.py"


rule descriptive_remission_stratified:
    # PRE-baseline descriptive table: remitters (n=22) vs non_remitters (n=6).
    # Only MetS+ subjects. Mann-Whitney / Fisher exact, BH correction per family.
    input:
        data   = "data/processed/bariatric_clinical_66.csv",
        config = "config/config.yaml"
    output:
        csv  = "results/tables/descriptive_remission_stratified.csv",
        html = "results/tables/descriptive_remission_stratified.html"
    shell:
        "python3 {SCRIPTS}/descriptive_remission_stratified.py"


rule descriptive_mets_stratified:
    # PRE-baseline descriptive table stratified by MetS status (MetS+ n=28 vs MetS− n=5).
    # Mann-Whitney U for continuous, Fisher's exact for binary, BH correction per family.
    input:
        data   = "data/processed/bariatric_clinical_66.csv",
        config = "config/config.yaml"
    output:
        csv  = "results/tables/descriptive_mets_stratified.csv",
        html = "results/tables/descriptive_mets_stratified.html"
    shell:
        "python3 {SCRIPTS}/descriptive_mets_stratified.py"


# -----------------------------------------------------------------------------
# DESeq2 differential abundance analyses
# -----------------------------------------------------------------------------

rule deseq2_5vs6:
    # POST (group 6) vs PRE (group 5) bariatric surgery — paired design.
    input:
        "data/processed/ps_filt_5vs6.rds"
    output:
        xlsx    = "results/deseq2/deseq2_5vs6_results.xlsx",
        volcano = "results/deseq2/volcano_5vs6.png"
    shell:
        "Rscript {SCRIPTS}/04_deseq2_5vs6.R"


rule deseq2_remission:
    # MetS remitters vs non-remitters at baseline (PRE).
    input:
        ps       = "data/processed/ps_filt_5vs6.rds",
        clinical = "data/processed/clinical_all.csv"
    output:
        xlsx    = "results/deseq2/deseq2_remission_results.xlsx",
        volcano = "results/deseq2/volcano_remission.png"
    shell:
        "Rscript {SCRIPTS}/05_deseq2_remission.R"


rule deseq2_mets_baseline:
    # MetS+ vs MetS- at baseline (PRE).
    input:
        ps       = "data/processed/ps_filt_5vs6.rds",
        clinical = "data/processed/clinical_all.csv"
    output:
        xlsx    = "results/deseq2/deseq2_mets_baseline_results.xlsx",
        volcano = "results/deseq2/volcano_mets_baseline.png"
    shell:
        "Rscript {SCRIPTS}/06_deseq2_mets_baseline.R"


rule deseq2_remitters_vs_metsneg:
    # MetS+ remitters vs MetS- subjects at baseline (PRE).
    input:
        ps       = "data/processed/ps_filt_5vs6.rds",
        clinical = "data/processed/clinical_all.csv"
    output:
        xlsx    = "results/deseq2/deseq2_remitters_vs_metsneg_results.xlsx",
        volcano = "results/deseq2/volcano_remitters_vs_metsneg.png"
    shell:
        "Rscript {SCRIPTS}/08_deseq2_remitters_vs_metsneg.R"


# -----------------------------------------------------------------------------
# Cross-comparison visualisation
# -----------------------------------------------------------------------------

rule heatmap_intersection:
    # log2FC heatmap across all three baseline comparisons for ASVs significant
    # in at least one of remission or MetS analyses.
    input:
        "results/deseq2/deseq2_remission_results.xlsx",
        "results/deseq2/deseq2_mets_baseline_results.xlsx",
        "results/deseq2/deseq2_5vs6_results.xlsx"
    output:
        "results/deseq2/heatmap_intersection.png"
    shell:
        "Rscript {SCRIPTS}/07_heatmap_intersection.R"


rule taxonomy_barplots:
    # Stacked relative abundance barplot at one rank for one comparison.
    # The same script handles all three comparisons via --comparison flag.
    input:
        ps       = "data/processed/ps_filt_5vs6.rds",
        clinical = "data/processed/clinical_all.csv"
    output:
        "results/metagenomics/barplot_{rank}_{comparison}.png"
    params:
        rank       = "{rank}",
        comparison = "{comparison}",
        top_n      = config["barplots"]["top_n"],
        width      = config["barplots"]["width_cm"],
        height     = config["barplots"]["height_cm"],
        dpi        = config["barplots"]["dpi"]
    shell:
        """
        Rscript {SCRIPTS}/taxonomy_barplots.R \
            --rank       {params.rank} \
            --comparison {params.comparison} \
            --top_n      {params.top_n} \
            --width      {params.width} \
            --height     {params.height} \
            --dpi        {params.dpi} \
            --ps         {input.ps} \
            --clinical   {input.clinical} \
            --out        {output}
        """


# -----------------------------------------------------------------------------
# Report
# -----------------------------------------------------------------------------

rule html_report:
    input:
        # QC
        rarefaction       = "results/figures/qc/rarefaction_curves.png",
        # Combined figure (all panels including PCoA row)
        fig_combined      = "results/figures/figure1_combined.png",
        # Beta diversity CSV
        beta_csv          = "results/tables/beta_diversity_permanova.csv",
        # DESeq2 results
        xlsx_5vs6         = "results/deseq2/deseq2_5vs6_results.xlsx",
        xlsx_remission    = "results/deseq2/deseq2_remission_results.xlsx",
        xlsx_mets         = "results/deseq2/deseq2_mets_baseline_results.xlsx",
        xlsx_rem_metsneg  = "results/deseq2/deseq2_remitters_vs_metsneg_results.xlsx",
        # Volcano plots
        vol_5vs6          = "results/deseq2/volcano_5vs6.png",
        vol_remission     = "results/deseq2/volcano_remission.png",
        vol_mets          = "results/deseq2/volcano_mets_baseline.png",
        vol_rem_metsneg   = "results/deseq2/volcano_remitters_vs_metsneg.png",
        # Heatmap
        heatmap           = "results/deseq2/heatmap_intersection.png",
        # Barplots (all 9)
        barplots          = expand("results/metagenomics/barplot_{rank}_{comparison}.png",
                                   rank=RANKS, comparison=COMPARISONS)
    output:
        "results/report/microbesomics_report.html"
    shell:
        "python3 {SCRIPTS}/make_html_report.py --out {output}"
