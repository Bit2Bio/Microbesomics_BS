rule figure1a:
    # Ridge plot PRE vs POST — anthropometrics, vitals, body composition, liver (Block A, 11 vars).
    # Reads p-adj from descriptive_baseline.csv instead of recomputing Wilcoxon + BH.
    input:
        data   = "data/processed/bariatric_clinical_66.csv",
        stats  = "results/tables/descriptive_baseline_stats.csv",
        config = "config/config.yaml"
    output:
        "results/figures/figure1a.png"
    shell:
        "{PYTHON} {SCRIPTS}/07a_figure1a_ridge_anthropometrics.py"


rule figure1b:
    # Ridge plot PRE vs POST — glycaemia, OGTT, lipids (Block B, 12 vars).
    # Reads p-adj from descriptive_baseline.csv instead of recomputing Wilcoxon + BH.
    input:
        data   = "data/processed/bariatric_clinical_66.csv",
        stats  = "results/tables/descriptive_baseline_stats.csv",
        config = "config/config.yaml"
    output:
        "results/figures/figure1b.png"
    shell:
        "{PYTHON} {SCRIPTS}/07b_figure1b_ridge_glycolipids.py"


