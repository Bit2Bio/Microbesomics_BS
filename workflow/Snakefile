rule figure1d_mets_alluvial:
    # Alluvial plot MetS PRE→POST: shows remission flow (MetS+→MetS−, n=22/28).
    input:
        data = "data/processed/bariatric_clinical_66.csv"
    output:
        "results/figures/figure1d_mets_alluvial.png"
    shell:
        "Rscript {SCRIPTS}/07d_figure1d_alluvial_mets.R"


rule figure1i_composition:
    # Stacked barplot of relative Phylum abundance (top 10 + Other), one bar per
    # sample, PRE and POST as separate facets. Samples ordered by Firmicutes PRE
    # abundance (descending); same pz order applied to POST for visual comparison.
    input:
        ps = "data/processed/ps_filt_5vs6.rds"
    output:
        "results/figures/figure1i_composition.png"
    shell:
        "Rscript {SCRIPTS}/07f_figure1i_phylum_barplot.R"


rule figure1j_phylum_clr:
    # Diverging barplot of CLR-transformed PRE→POST change for all tested phyla.
    # CLR uses a pseudocount = min_nonzero/2 to handle phyla with structural zeros.
    # Statistics: paired t-test on CLR values, BH correction.
    input:
        ps = "data/processed/ps_filt_5vs6.rds"
    output:
        "results/figures/figure1j_phylum_clr.png"
    shell:
        "Rscript {SCRIPTS}/07g_figure1j_phylum_clr.R"


rule figure1_combined:
    # Assembles three rows into Figure 1:
    #   Row 1 (a-d): clinical ridge plots + MetS alluvial
    #   Row 2 (e-h): PCoA and beta-diversity distance panels
    #   Row 3 (i-j): phylum composition barplot + CLR diverging barplot
    input:
        a = "results/figures/figure1a.png",
        b = "results/figures/figure1b.png",
        c = "results/figures/figure1c.png",
        d = "results/figures/figure1d_mets_alluvial.png",
        i = "results/figures/figure1i_composition.png",
        j = "results/figures/figure1j_phylum_clr.png"
    output:
        "results/figures/figure1_combined.png"
    shell:
        "{PYTHON} {SCRIPTS}/07h_figure1_assemble.py"


rule rarefaction_curves:
    # QC plot — rarefaction curves for all 66 bariatric samples (PRE/POST).
    # Informs choice of rarefaction depth for alpha diversity analyses.
    input:
        ps = "data/processed/ps_filt_5vs6.rds"
    output:
        "results/figures/qc/rarefaction_curves.png"
    shell:
        "Rscript {SCRIPTS}/05c_qc_rarefaction_curves.R"


rule figure_lfc_clinical:
