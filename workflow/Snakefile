configfile: "config/config.yaml"

RANKS       = config["barplots"]["ranks"]
COMPARISONS = config["barplots"]["comparisons"]

SCRIPTS = "workflow/scripts"
PYTHON  = "/home/lorenzo/anaconda3/envs/python_env/bin/python3"


rule all:
    input:
        # --- Preprocessing ---
        "data/processed/ps_raw.rds",
        "data/processed/clinical_all.csv",
        "data/processed/bariatric_clinical_66.csv",
        "data/processed/ps_filt_5vs6.rds",
        # --- DESeq2 results ---
        "results/deseq2/deseq2_5vs6_results.xlsx",
        "results/deseq2/volcano_5vs6.png",
        "results/deseq2/deseq2_remission_results.xlsx",
        "results/deseq2/volcano_remission.png",
        "results/deseq2/deseq2_mets_baseline_results.xlsx",
        "results/deseq2/volcano_mets_baseline.png",
        "results/deseq2/deseq2_remitters_vs_metsneg_results.xlsx",
        "results/deseq2/volcano_remitters_vs_metsneg.png",
        # --- QC ---
        "results/figures/qc/rarefaction_curves.png",
        # --- Descriptive tables and figures ---
        "results/figures/figure_lfc_clinical.png",
        "results/figures/figure1_combined.png",
        "results/figures/figure1d_mets_alluvial.png",
        # --- Alpha and beta diversity ---
        "results/figures/figure_alpha_diversity.png",
        "results/figures/figure2_combined.png",
        "results/tables/descriptive_baseline.csv",
        "results/tables/descriptive_mets_stratified.csv",
        "results/tables/descriptive_remission_stratified.csv",
        # --- Cross-comparison heatmap ---
        "results/deseq2/heatmap_intersection.png",
        # --- Taxonomy barplots ---
        expand("results/metagenomics/barplot_{rank}_{comparison}.png",
               rank=RANKS, comparison=COMPARISONS),
        # --- Final report ---
        "results/report/microbesomics_report.html"


# -----------------------------------------------------------------------------
# Preprocessing
# -----------------------------------------------------------------------------

rule import_qiime2:
    # Imports QIIME2 QZA artifacts and builds a bare phyloseq object.
    # Run once; depends on raw QZA files which are not tracked by git.
    input:
        "data/raw/qza/asv_table.qza",
        "data/raw/qza/taxonomy.qza",
        "data/raw/qza/fasttree_tree_rooted.qza",
        "data/raw/qza/rep_seq.qza"
    output:
        "data/processed/ps_raw.rds"
    shell:
        "Rscript {SCRIPTS}/01_import_qiime2_phyloseq.R"


rule preprocess_clinical:
    # Reads the IGA Excel file, harmonises column names across sheets,
    # computes MetS criteria (NCEP ATP III 2005) and writes clinical_all.csv.
    input:
        "data/raw/Copia di Microobesomics_clinical data IGA 260324.xlsx"
    output:
        "data/processed/clinical_all.csv",
        "data/processed/clinical_all.xlsx"
    shell:
        "Rscript {SCRIPTS}/02_clinical_mets_criteria.R"


rule preprocess_bariatric:
    # Extracts the 66 samples (33 complete PRE/POST pairs) from clinical_all.csv.
    # Adds remission label and produces the canonical bariatric clinical dataset.
    input:
        "data/processed/clinical_all.csv"
    output:
        "data/processed/bariatric_clinical_66.csv",
        "data/processed/bariatric_clinical_66.xlsx"
    shell:
        "Rscript {SCRIPTS}/03_clinical_bariatric_remission.R"


rule figure2a_pcoa_bray:
    # PCoA (Bray-Curtis, Unweighted UniFrac) PRE vs POST + paired PERMANOVA.
    # Also generates within-patient vs between-patient distance boxplots for each metric.
    input:
        ps = "data/processed/ps_rarefied_beta.rds"
    output:
        fig_bc    = "results/figures/figure2a_pcoa_braycurtis.png",
        fig_bc_d  = "results/figures/figure2b_bc_distances.png",
        fig_uuf   = "results/figures/figure2c_pcoa_unifrac.png",
        fig_uuf_d = "results/figures/figure2d_uuf_distances.png",
        csv       = "results/tables/beta_diversity_permanova.csv"
    shell:
        "Rscript {SCRIPTS}/07e_figure1eh_pcoa_beta.R"


rule figure2_combined:
    # Assembles the four beta diversity panels into Figure 2.
    input:
        a = "results/figures/figure2a_pcoa_braycurtis.png",
        b = "results/figures/figure2b_bc_distances.png",
        c = "results/figures/figure2c_pcoa_unifrac.png",
        d = "results/figures/figure2d_uuf_distances.png"
    output:
        "results/figures/figure2_combined.png"
    shell:
        "{PYTHON} {SCRIPTS}/08b_figure2_assemble.py"


rule preprocess_beta_diversity:
    # Rarefied phyloseq for beta diversity: filtered ASVs (ps_filt_5vs6 criteria),
    # SS-04 pair excluded (S211 PRE: 8,069 reads), rarefied at 75,000 reads.
    input:
        ps     = "data/processed/ps_filt_5vs6.rds",
        config = "config/config.yaml"
    output:
        "data/processed/ps_rarefied_beta.rds"
    shell:
        "Rscript {SCRIPTS}/05a_phyloseq_rarefy_beta.R"


rule preprocess_alpha_diversity:
    # Builds the phyloseq object for alpha diversity:
    #   - unfiltered ASVs (no prevalence/variance filter — would bias richness)
    #   - excludes pairs listed in config alpha_diversity.exclude_pairs (SS-04: PRE outlier at 8,069 reads)
    #   - rarefied to alpha_diversity.rarefaction_depth (75,000 reads)
    input:
        ps       = "data/processed/ps_raw.rds",
        clinical = "data/processed/clinical_all.csv",
        config   = "config/config.yaml"
    output:
        "data/processed/ps_rarefied_alpha.rds"
    shell:
        "Rscript {SCRIPTS}/05b_phyloseq_rarefy_alpha.R"


rule figure_alpha_diversity:
    # Paired PRE→POST plots for Shannon index and Observed ASVs (n=32 pairs).
    # SS-04 excluded; rarefied at 75,000 reads on unfiltered ASVs.
    input:
        "data/processed/ps_rarefied_alpha.rds"
    output:
        "results/figures/figure_alpha_diversity.png"
    shell:
        "Rscript {SCRIPTS}/08a_figure_alpha_diversity.R"


rule filter_5vs6:
    # Subsets phyloseq to the 33 complete bariatric surgery pairs and applies
    # ASV feature filtering (count + prevalence + variance).
    # Depends on bariatric_clinical_66.csv (from preprocess_bariatric) to attach
    # the remission label to sample_data — so DESeq2 scripts can read it directly.
    input:
        ps       = "data/processed/ps_raw.rds",
        clinical = "data/processed/clinical_all.csv",
        bari     = "data/processed/bariatric_clinical_66.csv"
    output:
        "data/processed/ps_filt_5vs6.rds"
    shell:
        "Rscript {SCRIPTS}/04_phyloseq_bariatric_filter.R"


