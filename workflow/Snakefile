    shell:
        "Rscript {SCRIPTS}/10c_deseq2_remitters_vs_metsneg.R"


# -----------------------------------------------------------------------------
# Cross-comparison visualisation
# -----------------------------------------------------------------------------

rule heatmap_intersection:
    # log2FC heatmap across all three baseline comparisons for ASVs significant
    # in at least one of remission or MetS analyses.
    input:
        "results/deseq2/deseq2_remission_results.xlsx",
        "results/deseq2/deseq2_mets_baseline_results.xlsx",
        "results/deseq2/deseq2_5vs6_results.xlsx"
    output:
        "results/deseq2/heatmap_intersection.png"
    shell:
        "Rscript {SCRIPTS}/11_figure_deseq2_heatmap.R"


rule taxonomy_barplots:
    # Stacked relative abundance barplot at one rank for one comparison.
    # The same script handles all three comparisons via --comparison flag.
    input:
        ps       = "data/processed/ps_filt_5vs6.rds",
        clinical = "data/processed/clinical_all.csv"
    output:
        "results/metagenomics/barplot_{rank}_{comparison}.png"
    params:
        rank       = "{rank}",
        comparison = "{comparison}",
        top_n      = config["barplots"]["top_n"],
        width      = config["barplots"]["width_cm"],
        height     = config["barplots"]["height_cm"],
        dpi        = config["barplots"]["dpi"]
    shell:
        """
        Rscript {SCRIPTS}/12_figure_taxonomy_barplots.R \
            --rank       {params.rank} \
            --comparison {params.comparison} \
            --top_n      {params.top_n} \
            --width      {params.width} \
            --height     {params.height} \
            --dpi        {params.dpi} \
            --ps         {input.ps} \
            --clinical   {input.clinical} \
            --out        {output}
        """


# -----------------------------------------------------------------------------
# Report
# -----------------------------------------------------------------------------

rule html_report:
    input:
        # QC
        rarefaction       = "results/figures/qc/rarefaction_curves.png",
        # Combined figure (all panels including PCoA row)
        fig_combined      = "results/figures/figure1_combined.png",
        # Beta diversity CSV
        beta_csv          = "results/tables/beta_diversity_permanova.csv",
        # DESeq2 results
        xlsx_5vs6         = "results/deseq2/deseq2_5vs6_results.xlsx",
        xlsx_remission    = "results/deseq2/deseq2_remission_results.xlsx",
        xlsx_mets         = "results/deseq2/deseq2_mets_baseline_results.xlsx",
        xlsx_rem_metsneg  = "results/deseq2/deseq2_remitters_vs_metsneg_results.xlsx",
        # Volcano plots
        vol_5vs6          = "results/deseq2/volcano_5vs6.png",
        vol_remission     = "results/deseq2/volcano_remission.png",
        vol_mets          = "results/deseq2/volcano_mets_baseline.png",
        vol_rem_metsneg   = "results/deseq2/volcano_remitters_vs_metsneg.png",
        # Heatmap
        heatmap           = "results/deseq2/heatmap_intersection.png",
        # Barplots (all 9)
        barplots          = expand("results/metagenomics/barplot_{rank}_{comparison}.png",
                                   rank=RANKS, comparison=COMPARISONS)
    output:
        "results/report/microbesomics_report.html"
    shell:
        "{PYTHON} {SCRIPTS}/13_report_html.py --out {output}"
