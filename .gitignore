# Ignore everything by default
*

# Temporary / lock files
~lock.*
.~lock.*
*#
*.xlsx

# --- Track these files and directories ---

!.gitignore
!README.md

# New scripts
!scripts/
!scripts/**

# Processed data (anonymised outputs)
!data/
!data/processed/
!data/processed/*.csv

# Old scripts (archived reference)
!_old/
!_old/R-scripts/
!_old/R-scripts/**
