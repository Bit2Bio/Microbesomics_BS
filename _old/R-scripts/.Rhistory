library(readr)
library(dplyr)
library(tidyr)
library(tibble)
library(stringr)
mat <- read_csv("../data/serum_proteomics/protein_count_matrix.csv")
# prima colonna = nomi proteine
mat <- as.data.frame(mat)
rownames(mat) <- mat[[1]]
mat[[1]] <- NULL
# metadati campioni
sample_meta <- read_csv("../data/serum_proteomics/sample_metadata.csv")
# metadati proteine
protein_meta <- read_csv("../data/serum_proteomics/protein_metadata.csv")
# trasformazione log2
mat_log <- log2(mat + 1)
# layout affiancato
par(mfrow = c(1, 2))
# --- NON log ---
boxplot(mat,
horizontal = TRUE,
outline = FALSE,
col = "lightblue",
main = "Raw",
xlab = "Intensità",
yaxt = "n")   # <-- rimuove nomi campioni
# --- LOG2 ---
boxplot(mat_log,
horizontal = TRUE,
outline = FALSE,
col = "lightgreen",
main = "Log2",
xlab = "log2 intensità",
yaxt = "n")
# reset layout
par(mfrow = c(1, 1))
# soglia low-abundance globale
lod_threshold <- quantile(as.matrix(mat_log), 0.05)
# tieni proteine sopra soglia in almeno il 25% dei campioni
keep_lod <- rowMeans(mat_log > lod_threshold) >= 0.25
# matrice filtrata
mat_filt_lod <- mat_log[keep_lod, ]
# riepilogo
cat("Proteine iniziali:", nrow(mat_log), "\n")
cat("Proteine dopo filtro low-abundance:", nrow(mat_filt_lod), "\n")
cat("Proteine rimosse:", nrow(mat_log) - nrow(mat_filt_lod), "\n")
#Calcola varianza per proteina
var_genes <- apply(mat_filt_lod, 1, var)
# Definisce una soglia di varianza basata sul 20° percentile:
# il valore sotto cui cade il 20% delle proteine con varianza più bassa
threshold_var <- quantile(var_genes, 0.2)
# Crea un vettore logico che identifica le proteine da mantenere:
# TRUE → varianza superiore alla soglia (proteine più variabili, informative)
# FALSE → varianza bassa (potenzialmente poco informative, da rimuovere)
keep_var <- var_genes > threshold_var
mat_filt <- mat_filt_lod[keep_var, ]
cat("Proteine dopo LOD filter:", nrow(mat_filt_lod), "\n")
cat("Proteine dopo var filter:", nrow(mat_filt), "\n")
hist(var_genes,
breaks = 50,
main = "Distribuzione varianza proteine",
xlab = "Varianza")
par(mfrow = c(1,2))
plot(prcomp(t(mat_filt_lod))$x[,1:2],
main = "LOD only",
pch = 19)
plot(prcomp(t(mat_filt))$x[,1:2],
main = "LOD + var",
pch = 19)
par(mfrow = c(1,1))
sample_meta <- read.csv(
"../data/metabolomics/sample_metadata.csv",
stringsAsFactors = FALSE
)
group <- factor(sample_meta$METABOLIC_STATUS)
table(group)
library(limma)
run_limma <- function(mat, sample_meta) {
# rimuovi NOT_APPLICABLE
valid_samples <- sample_meta$METABOLIC_STATUS != "NOT_APPLICABLE"
mat <- mat[, valid_samples]
sample_meta <- sample_meta[valid_samples, ]
# gruppo
group <- factor(sample_meta$METABOLIC_STATUS)
# design
design <- model.matrix(~ 0 + group)
colnames(design) <- levels(group)
# contrasti
contrast_matrix <- makeContrasts(
S1_vs_S0 = M_Status_1 - M_Status_0,
S2_vs_S0 = M_Status_2 - M_Status_0,
S3_vs_S0 = M_Status_3 - M_Status_0,
levels = design
)
# fit
fit <- lmFit(mat, design)
fit2 <- contrasts.fit(fit, contrast_matrix)
fit2 <- eBayes(fit2)
# risultati
res <- list(
S1 = topTable(fit2, coef = "S1_vs_S0", number = Inf),
S2 = topTable(fit2, coef = "S2_vs_S0", number = Inf),
S3 = topTable(fit2, coef = "S3_vs_S0", number = Inf)
)
return(res)
}
res_lod      <- run_limma(mat_filt_lod, sample_meta)
res_lod_var  <- run_limma(mat_filt, sample_meta)
# Controllo allineamento tra metadata e matrice
stopifnot(all(colnames(mat_filt) == (sample_meta$CLIENT_IDENTIFIER)))
# Variabile di interesse
group <- factor(sample_meta$CVD_EVENT_YES.NO)
# Design matrix: confronto 1 vs 0
design <- model.matrix(~ group)
# Fit limma
fit <- lmFit(mat_filt_lod, design)
fit <- eBayes(fit)
# Risultati completi
res <- topTable(fit, coef = "group1", number = Inf)
res_lod
View(res_lod)
View(res_lod)
View(res_lod[["S1"]])
View(res_lod[["S2"]])
View(res_lod[["S3"]])
res_lod      <- run_limma(mat_filt_lod, sample_meta)
View(res_lod)
View(res_lod_var)
View(res_lod_var[["S1"]])
View(res_lod_var[["S2"]])
View(res_lod_var[["S3"]])
table(group)
group <- factor(sample_meta$METABOLIC_STATUS)
table(group)
View(res_lod_var)
